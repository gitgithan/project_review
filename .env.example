# Pick ONE way to reach Gemini (see README "Setup").

# Option A: Vertex AI with your Application Default Credentials
# (run `gcloud auth application-default login` first)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini API key from https://aistudio.google.com/apikey
# (free tier: Google may use the content you send; see README before using on student code)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key

# Optional overrides
# REVIEW_MODEL=gemini-3.1-flash-lite
# PROJECTS_DIR=./projects
# MAX_PREVIEW_BYTES=524288
